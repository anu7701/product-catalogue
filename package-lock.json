{
  "name": "product-catalogue",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "product-catalogue",
      "workspaces": [
        "packages/*",
        "apps/*"
      ],
      "engines": {
        "node": ">=24"
      }
    },
    "apps/api": {
      "name": "@catalogue/api",
      "version": "0.0.0",
      "dependencies": {
        "@catalogue/shared": "*"
      }
    },
    "apps/web": {
      "name": "@catalogue/web",
      "version": "0.0.0",
      "dependencies": {
        "@catalogue/shared": "*"
      }
    },
    "node_modules/@catalogue/api": {
      "resolved": "apps/api",
      "link": true
    },
    "node_modules/@catalogue/shared": {
      "resolved": "packages/shared",
      "link": true
    },
    "node_modules/@catalogue/web": {
      "resolved": "apps/web",
      "link": true
    },
    "packages/shared": {
      "name": "@catalogue/shared",
      "version": "0.0.0"
    }
  }
}
