# Product Catalogue — configuration
#
# Every setting the app reads, with safe defaults for running locally.
# Copy to .env to override. Never commit .env or real credentials.
# Spec: spec/ARCHITECTURE.md §3.7. Invalid critical settings stop the API from starting.

# ---------------------------------------------------------------------------
# Product data source (T13)
# ---------------------------------------------------------------------------
# fakestore = live Fake Store API (default) · fixture = committed offline snapshot
PRODUCT_SOURCE=fakestore
# Only used when PRODUCT_SOURCE=fakestore
PRODUCT_SOURCE_URL=https://fakestoreapi.com

# ---------------------------------------------------------------------------
# Catalogue rules
# ---------------------------------------------------------------------------
# Owner-chosen featured products for the home page, in display order (CFG-01).
# Comma-separated product IDs; at most 5 are used. Stale IDs are skipped with a warning.
FEATURED_PRODUCT_IDS=1,5,9,15,18
# Max products in a category page's "Top rated" section (A8)
CATEGORY_TOP_RATED_COUNT=3

# ---------------------------------------------------------------------------
# Enquiry email (CFG-02). Defaults deliver to the local Mailpit test mailbox (CFG-03).
# ---------------------------------------------------------------------------
# Required: the API refuses to start if either is missing or not a valid email (NEW-48)
SALES_INBOX=sales@example.com
MAIL_FROM=no-reply@example.com
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
# Leave empty for Mailpit; set for a real provider (e.g. Amazon SES SMTP credentials)
SMTP_USER=
SMTP_PASS=

# ---------------------------------------------------------------------------
# Abuse protection (ENQ-06, NEW-43)
# ---------------------------------------------------------------------------
ENQUIRY_RATE_LIMIT_MAX=5
ENQUIRY_RATE_LIMIT_WINDOW_MINUTES=15

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
# Public URL of the site, used for product links in enquiry emails
PUBLIC_SITE_URL=http://localhost:8080
# Address and port the API listens on
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
# Number of trusted proxy hops in front of the API, used to find the real client IP
# for rate limiting. 1 = the web container's Nginx locally. Never "true" (see SPEC_REVIEW R-07).
TRUST_PROXY=1

# ---------------------------------------------------------------------------
# Web app (build-time, CFG-04)
# ---------------------------------------------------------------------------
VITE_STORE_NAME=Catalogue
